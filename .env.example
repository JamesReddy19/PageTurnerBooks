# Copy to .env (or export these variables) before running in production.
# Never commit real secrets.

# Required in production: long random string, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=

# Optional: bootstrap administrator account created on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Send session cookies over HTTPS only (set to 1 behind TLS).
COOKIE_SECURE=0

# Absolute path of the SQLite database (defaults to instance/database.db).
PAGETURNER_DATABASE=

# Email delivery. Leave MAIL_SERVER empty to write messages to
# instance/mail_outbox.log instead of sending them.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@pageturnerbooks.local
